# UPIShield Environment Variables
# Frontend (Vercel) / Edge Functions (Supabase) Configuration

# Supabase API Endpoint & Anon Public Key (for Vercel Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Custom Backend API URL (Defaults to ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Supabase Edge Functions / Server-Side Environment Variables (Set in Supabase Dashboard)
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
